# PostgreSQL connection string used by Prisma and the pg pool.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Set to "true" when the database host requires TLS (Neon, Supabase, ...)
# and the connection string has no sslmode parameter.
DATABASE_SSL=false

# Secret used to sign JWTs. Required, minimum 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API listens on.
PORT=5000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
