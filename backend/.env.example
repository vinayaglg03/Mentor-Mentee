# PostgreSQL connection string used by Prisma and the pg pool.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Set to "true" when the database host requires TLS (Neon, Supabase, ...)
# and the connection string has no sslmode parameter.
DATABASE_SSL=false

# Secret used to sign JWTs. Required, minimum 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API listens on.
PORT=5000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Printed in the header of exported PDF and Excel reports.
COLLEGE_NAME="Your College Name"
COLLEGE_ADDRESS="City, State"
COLLEGE_DEPARTMENT="Department of Computer Science"
# Absolute or relative path to a PNG or JPG logo. Left blank, reports print
# without a logo.
COLLEGE_LOGO_PATH=

# Log verbosity: fatal | error | warn | info | debug | trace
# Defaults to debug outside production.
LOG_LEVEL=debug

# Set to "production" when deploying.
NODE_ENV=development

# Only used by the test suite (npm test). Point this at a throwaway database:
# every test run truncates it.
TEST_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/amis_test"

# --- Email notifications -------------------------------------------------

# Where the app is reachable; used for links in digest emails.
APP_URL=http://localhost:5173

# console (default, logs instead of sending) | smtp | resend
MAIL_DRIVER=console
MAIL_FROM="AMIS <no-reply@your-college.edu>"

# MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# MAIL_DRIVER=resend
RESEND_API_KEY=

# A HIGH alert still open after this many days is escalated to the HOD.
ALERT_ESCALATION_DAYS=7
# A mentee with no logged interaction for this long is flagged.
INACTIVITY_DAYS=30

# Set to false when running more than one instance, and drive the jobs from an
# external scheduler instead (see src/jobs/scheduler.js).
NOTIFICATIONS_SCHEDULE=true
DAILY_DIGEST_CRON="30 1 * * *"
WEEKLY_DIGEST_CRON="0 2 * * 1"
INACTIVITY_CRON="0 3 * * *"

# --- Sign-in ---------------------------------------------------------------

# Google Workspace sign-in. Create an OAuth 2.0 Client ID (type: Web
# application) in the Google Cloud console, and register the callback below as
# an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Comma-separated Workspace domains allowed to sign in. Leave empty and ANY
# Google account can sign in, which you almost certainly do not want.
ALLOWED_EMAIL_DOMAINS=yourcollege.edu.in

# Password sign-in. Turn this off once Google sign-in works; a SUPER_ADMIN can
# still use a password as a break-glass route either way.
AUTH_PASSWORD_ENABLED=false

# Session lifetimes. The access token lives in browser memory; the refresh
# token is an httpOnly cookie that rotates on every use.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Cookie flags. COOKIE_SECURE must be true in production (https).
REFRESH_COOKIE_NAME=amis_refresh
COOKIE_SECURE=false
# 'lax' when the API and the app share a registrable domain; 'none' (with
# COOKIE_SECURE=true) only when they genuinely differ.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Operations ------------------------------------------------------------

# Error monitoring. With no DSN, monitoring is off and nothing is sent
# anywhere. Student names and emails are scrubbed from every event either way.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Shown by /api/health and /api/ready, and attached to error reports.
APP_VERSION=

# --- Privacy, retention and support ----------------------------------------

# How long the audit log is kept before `npm run job:prune-audit` archives and
# removes it. Shown on the in-app privacy page.
RETENTION_AUDIT_YEARS=3

# When a former student's record is reported as past its retention window.
# Nothing is ever deleted automatically; `npm run job:retention` reports and a
# person decides. See docs/PRIVACY.md.
RETENTION_GRADUATED_YEARS=7

# Shown on the privacy page as who to write to about a data request.
PRIVACY_CONTACT_EMAIL=

# Where the in-app "Report a problem" button sends reports. Without it,
# reports are still recorded in the server log.
SUPPORT_EMAIL=
