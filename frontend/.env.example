# Base URL of the AMIS backend API, without a trailing slash.
# "/api" is appended automatically if it is not already present.
# Defaults to http://localhost:5000 when unset.
VITE_API_URL=http://localhost:5000

# Error monitoring. Leave empty to disable; PII is scrubbed from events
# regardless of this setting.
VITE_SENTRY_DSN=
VITE_APP_VERSION=
