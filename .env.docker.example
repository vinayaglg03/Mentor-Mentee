# Copy this file to .env in the same directory, fill it in, and run
#   docker compose up -d
# Nothing else needs editing. See docs/DEPLOYMENT.md.

# ---------------------------------------------------------------- required --

# The domain this will be reached on. Use "localhost" while testing; use a
# real domain in production and Caddy will fetch an HTTPS certificate for it.
APP_DOMAIN=localhost
APP_URL=http://localhost

# The database password. Any long random string; nobody types this by hand.
# Generate one with:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Signs session tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -hex 48
JWT_SECRET=

# ------------------------------------------------------------------ sign-in --

# Google Workspace sign-in. Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and register
#   https://YOUR-DOMAIN/api/auth/google/callback
# as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these email domains may sign in. Comma-separated.
ALLOWED_EMAIL_DOMAINS=yourcollege.edu.in

# Leave false once Google sign-in works. A SUPER_ADMIN can always use a
# password as a break-glass route.
AUTH_PASSWORD_ENABLED=false

# Set false only if you are running on plain HTTP (testing).
COOKIE_SECURE=true

# ----------------------------------------------------------------- optional --

COLLEGE_NAME=Your College
COLLEGE_ADDRESS=City, State
COLLEGE_DEPARTMENT=

# Email digests. console = log instead of sending.
MAIL_DRIVER=console
MAIL_FROM=AMIS <no-reply@yourcollege.edu.in>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Error monitoring. Leave empty to keep everything on your own server.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Shown on /api/health, useful when you have more than one environment.
APP_VERSION=

LOG_LEVEL=info

# Change these if ports 80 and 443 are already in use on the host.
HTTP_PORT=80
HTTPS_PORT=443

# Database name and user. Rarely worth changing.
POSTGRES_USER=amis
POSTGRES_DB=amis
